# ==============================================================================
# Cafnet Backend Production & Environment Configuration Reference
# Use this template to configure environment variables in Render / staging / local.
# NEVER commit real credentials, passwords, or tokens to version control.
# ==============================================================================

# 1. Neon PostgreSQL Database Connectivity
# Replace with your actual Neon PostgreSQL pooled connection string:
# Format: postgresql://[user]:[password]@[endpoint-pooler].[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database Connection Pool Tuning (conservatively sized for Neon serverless)
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# 2. Server Runtime Environment & Transport
# Values: development | staging | production
APP_ENV=production

# Server listening port (Render automatically provides the PORT environment variable)
PORT=8080

# HTTP Transport Timeouts & Request Constraints
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=30s
HTTP_MAX_BODY_BYTES=1048576

# 3. CORS & Origin Whitelist
# Explicit comma-separated list of allowed frontend origins (no wildcards with credentials!)
# Example: https://cafnet-web.vercel.app,http://localhost:3000
AUTH_ALLOWED_ORIGINS=https://cafnet-web.vercel.app,http://localhost:3000

# 4. Session & Cookie Security
# Cookie name for server-side opaque session token
AUTH_SESSION_COOKIE_NAME=cafnet_session

# Must be true in production (HTTPS)
AUTH_COOKIE_SECURE=true

# Set to "None" when Frontend (Vercel) and Backend (Render) are cross-origin.
# Set to "Lax" or "Strict" if hosted on the same root domain.
AUTH_COOKIE_SAME_SITE=None

# Session lifetime (e.g. 720h = 30 days)
AUTH_SESSION_TTL=720h

# 5. OTP & Authentication Rate Limiting
AUTH_OTP_TTL=5m
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_OTP_REQUEST_COOLDOWN=60s

# 6. Test & Staging Verification Code (STRICTLY DISABLED IN PRODUCTION)
# In production, AUTH_DEV_MODE must be false to enforce genuine SMS generation.
# In staging/dev, set to true to allow dev_otp test codes without SMS gateway fees.
AUTH_DEV_MODE=false
AUTH_DETERMINISTIC_OTP=123456
